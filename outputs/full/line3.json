lor":"var(--orange)","width":2}},{"type":"line","x0":26.0,"x1":26.0,"y0":0,"y1":1,"yref":"paper","line":{"color":"var(--hud)","width":2}},{"type":"line","x0":28.0,"x1":28.0,"y0":0,"y1":1,"yref":"paper","line":{"color":"var(--ti)","width":2}}],"annotations":[{"x":24,"y":1,"yref":"paper","xanchor":"right","yanchor":"top","showarrow":false,"text":"inicio real ","font":{"size":11,"color":"var(--navy)"}}],"legend":{"y":1.24},"margin":{"r":70},"xaxis":{"title":{"text":"Número de vuelo · DS02 · motor 15 (prueba)"}},"yaxis":{"title":{"text":"Índice de salud"}},"yaxis2":{"overlaying":"y","side":"right","title":{"text":"CUSUM","standoff":12},"showgrid":false,"automargin":true}}}},"insights":{"line3_delay":"Con cada umbral calibrado en motores de desarrollo para no superar 10 % de falsas alarmas, en los 39 motores de prueba el CUSUM online da la alarma con una demora mediana de <b>6 vuelos</b> respecto del inicio real, cuando falta una mediana de 43 vuelos para la falla y sólo ocurrió el <b>4 %</b> del desgaste total. El umbral sobre T48 sola tarda 7 vuelos (4 % del desgaste). PELT, que mira la serie completa, marca 4. Alarmas antes del inicio real en prueba: CUSUM 10 %, T48 15 %, PELT 26 %.","line3_example":"El índice de salud resume los 14 residuos en un número: plano mientras el motor está sano y creciente cuando empieza la degradación. El CUSUM acumula los excesos sobre lo normal y da la alarma (línea de color) cuando la acumulación supera el umbral."},"line3_table":[{"método":"CUSUM online","motores":39,"detectados [%]":100.0,"alarma antes del inicio real [%]":10.3,"demora mediana [vuelos]":6.0,"anticipación mediana a la falla [vuelos]":43.0,"desgaste ocurrido al alarmar [%]":3.8},{"método":"PELT offline","motores":39,"detectados [%]":100.0,"alarma antes del inicio real [%]":25.6,"demora mediana [vuelos]":4.0,"anticipación mediana a la falla [vuelos]":46.0,"desgaste ocurrido al alarmar [%]":2.3},{"método":"Umbral sobre T48","motores":39,"detectados [%]":94.9,"alarma antes del inicio real [%]":15.4,"demora mediana [vuelos]":7.0,"anticipación mediana a la falla [vuelos]":38.0,"desgaste ocurrido al alarmar [%]":4.5}],"thresholds":{"cusum":8.932773109243698,"t48":2.936974789915966,"pelt":2.6722689075630255},"future_discussion_l3":["<b>Línea 3.</b> Con un índice de salud multivariado y un CUSUM se detecta el inicio del desgaste cuando ocurrió apenas el 4 % de la degradación total, sin usar el RUL. Los próximos pasos que propone la línea son aprender el índice de salud con Transformers auto-supervisados y Masked Autoencoders sobre la señal segundo a segundo (sin etiquetas) y combinarlo con change point detection bayesiano online para dar alarmas con una probabilidad asociada."]}